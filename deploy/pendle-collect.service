# 复制到 /etc/systemd/system/pendle-collect.service 前替换用户和绝对路径。
[Unit]
Description=Ondo 公开行情实时采集
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 使用专用非 root 用户；请先创建并授予项目 data/ 与 log/ 的写权限。
User=pendle
Group=pendle
# 将 /PATH/TO/pendle 替换为实际项目目录，三处路径保持一致。
WorkingDirectory=/PATH/TO/pendle
ExecStart=/PATH/TO/pendle/.venv/bin/python -m pendle collect --config /PATH/TO/pendle/collect.toml
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# 达到配置的磁盘上限后不自动重启；归档或调整上限后手动启动。
RestartPreventExitStatus=75
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
