# Replace the user and absolute paths before copying to /etc/systemd/system/pendle-collect.service.
[Unit]
Description=Ondo 公开行情实时采集
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Create a dedicated non-root user and grant write access to the project's data/ and log/ directories.
User=pendle
Group=pendle
# Replace /PATH/TO/pendle with the actual project directory in all three paths.
WorkingDirectory=/PATH/TO/pendle
ExecStart=/PATH/TO/pendle/.venv/bin/python -m pendle collect --config /PATH/TO/pendle/collect.toml
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# Do not restart automatically after reaching the disk limit; archive data or adjust the limit, then start manually.
RestartPreventExitStatus=75
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
